# Isi semua nilai ini di Netlify: Site configuration → Environment variables.
# Untuk mencoba di laptop, salin file ini menjadi .env. JANGAN unggah .env ke GitHub.

# ---- Dari Firebase: Project settings → General → Your apps → Web app ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Dari Firebase: Project settings → Service accounts → Generate new private key ----
# (RAHASIA) Salin dari file JSON yang terunduh
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Email yang otomatis menjadi admin saat mendaftar (boleh lebih dari satu, pisahkan dengan koma) ----
ADMIN_EMAIL=
